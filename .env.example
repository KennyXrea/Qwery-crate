# Copy this file to .env.local and fill in the real values from
# Supabase → Project Settings → API keys / Data API.
# Only the PUBLISHABLE key (sb_publishable_…, or the legacy "anon public" key) goes here.
# NEVER put the secret / service_role key in this file or anywhere in the project.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
